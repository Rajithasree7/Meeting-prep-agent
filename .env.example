# Meeting Prep Agent - Environment Variables

# Supabase (pre-populated in Bolt environment)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend / Edge Function Secrets (configured via Supabase dashboard or MCP)
# These are NOT in the frontend .env — they are edge function secrets:
# SUPABASE_SERVICE_ROLE_KEY=auto-configured
# SUPABASE_URL=auto-configured

# Hindsight - Persistent Memory API
# Get these from your Hindsight deployment (https://hindsight.vectorize.io)
HINDSIGHT_API_KEY=your-hindsight-api-key
HINDSIGHT_BASE_URL=https://your-hindsight-instance.example.com

# Grok / xAI - AI Reasoning
# Get this from https://console.x.ai
XAI_API_KEY=your-xai-api-key
